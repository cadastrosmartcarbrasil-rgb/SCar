# ==========================================================================
# SCar - Variaveis de Ambiente
# Copie para .env.local e preencha com os valores do seu projeto Supabase.
# ==========================================================================

# --- Supabase (obrigatorio) ---
# Encontrado em: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave de servico (service_role). NUNCA exponha no cliente.
# Usada apenas em Route Handlers / Server Actions / Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Storage ---
NEXT_PUBLIC_SUPABASE_BUCKET_SINISTROS=sinistros-docs

# --- E-mail (Edge Function enviar-email) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="SCar Protecao Veicular <no-reply@seudominio.com.br>"

# --- Gateway bancario (mock / Asaas / PJBank) ---
GATEWAY_BANCO_API_URL=https://sandbox.asaas.com/api/v3
GATEWAY_BANCO_API_KEY=coloque_sua_chave_aqui
GATEWAY_WEBHOOK_SECRET=defina_um_segredo_forte

# --- Consulta de Placa (opcional; sem isso, cai no preenchimento manual) ---
PLACA_API_URL=https://api.provedor.com/placas/{placa}
PLACA_API_KEY=coloque_sua_chave_aqui

# --- Tabela FIPE (placafipe.com.br) ---
# Token da assinatura contratada. Fica SO no servidor (proxy /api/fipe).
# Habilita: consulta por placa (getplacafipe) + cascata marca/modelo/ano.
PLACAFIPE_TOKEN=coloque_seu_token_aqui
# Base da API (default abaixo; sobrescreva se o provedor mudar o dominio).
PLACAFIPE_BASE=https://api.placafipe.com.br

# --- Mapas / geolocalizacao da Assistencia 24h (proxy /api/v1/geo) ---
# Com a chave do Google, geocoding e rota usam Google Maps (Geocoding +
# Directions). SEM chave, o sistema cai automaticamente no OpenStreetMap
# (Nominatim) + OSRM, que sao publicos e nao exigem cadastro — o modulo
# funciona de imediato e "sobe de nivel" so preenchendo a variavel.
GOOGLE_MAPS_API_KEY=
# Identificacao exigida pela politica de uso do Nominatim (quando sem Google).
GEO_USER_AGENT="SCar/1.0 (protecao veicular; contato@smartvidanet.com.br)"
# Instancias alternativas (auto-hospedadas), se um dia quiser sair do publico.
NOMINATIM_BASE=https://nominatim.openstreetmap.org
OSRM_BASE=https://router.project-osrm.org
