# ==========================================================================
# SCar - Variaveis para deploy com Docker no VPS.
# No servidor: copie para .env  (cp .env.docker.example .env) e preencha.
#   cp .env.docker.example .env && nano .env
# ==========================================================================

# --- Dominio (usado pelo Caddy para emitir o SSL automatico) ---
# Coloque exatamente o dominio/subdominio que aponta para o IP do VPS.
DOMAIN=app.seudominio.com.br

# --- Supabase (Project Settings > API no painel do Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Storage ---
NEXT_PUBLIC_SUPABASE_BUCKET_SINISTROS=sinistros-docs

# --- E-mail (opcional; para a Edge Function de e-mail) ---
RESEND_API_KEY=
EMAIL_FROM=SCar Protecao Veicular <no-reply@seudominio.com.br>

# --- Consulta de placa (opcional; deixe vazio para preenchimento manual) ---
# Use {placa} no lugar onde a placa entra, ou informe a base que recebera /PLACA.
PLACA_API_URL=
PLACA_API_KEY=

# --- Tabela FIPE (placafipe.com.br) ---
# Token da assinatura contratada. Habilita consulta por placa + cascata.
PLACAFIPE_TOKEN=
# Base da API (deixe vazio para usar o default https://api.placafipe.com.br).
PLACAFIPE_BASE=

# --- Integracao com o MUTUAL (sistema atual) ---
# Token da integracao. Sem ele, a tela /integracao/mutual diz "nao configurado"
# em vez de fingir erro da Mutual. E o segredo mais sensivel do projeto: da
# LEITURA DA BASE INTEIRA de associados. Nunca vai ao navegador nem ao Git.
MUTUAL_API_TOKEN=
# Opcional; o padrao ja e o host de producao da Mutual.
MUTUAL_API_BASE=https://smartcar-api.mutualignit.com.br
