# ==========================================================================
# SCar - Variaveis para deploy com Docker no VPS.
# No servidor: copie para .env  (cp .env.docker.example .env) e preencha.
#   cp .env.docker.example .env && nano .env
# ==========================================================================

# --- Dominio (usado pelo Caddy para emitir o SSL automatico) ---
# Coloque exatamente o dominio/subdominio que aponta para o IP do VPS.
DOMAIN=app.seudominio.com.br

# --- Supabase (Project Settings > API no painel do Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Storage ---
NEXT_PUBLIC_SUPABASE_BUCKET_SINISTROS=sinistros-docs

# --- E-mail (opcional; para a Edge Function de e-mail) ---
RESEND_API_KEY=
EMAIL_FROM=SCar Protecao Veicular <no-reply@seudominio.com.br>
